# Normalize line endings so Windows, macOS, and Linux clones stay consistent
# and diffs stop churning on CRLF/LF differences.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.cls text eol=lf
*.trigger text eol=lf
*.js text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
