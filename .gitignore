# sf-agentic-coding-framework: framework persistence decision recorded here — see PROJECT_BOOTSTRAP.md
# Framework files (directives, standards, skills, workflows) are installed at the user level
# (~/.agents/ or %USERPROFILE%\.agents\) and are NOT stored in this repo. Only AGENTS.md (router)
# and .agents/project/ (team-shared docs) live in the repo.

# Local config template is tracked; actual config lives at ~/.agents/{repo_name}/.local-config.json
# (outside the repo). This entry is kept for safety in case any tool creates one locally.
.agents/.local-config.json

# Salesforce DX scratch directories
.sfdx/
.sf/
