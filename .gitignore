# sf-agentic-coding-framework: this is the MASTER framework repository.
# The full .agents/ tree (directives, standards, skills, workflows) is tracked here as canonical source.
# In installed project repos, framework files live at the user level (~/.agents/) and only
# AGENTS.md and .agents/project/ remain in the repo.

# Local config template is tracked; actual config lives at ~/.agents/{repo_name}/.local-config.json
# (outside the repo). This entry is kept for safety in case any tool creates one locally.
.agents/.local-config.json

# Repo-local fallbacks (used by sandboxed/remote agents that cannot write to ~/.agents/)
.agents/temp/
.agents/state/

# Salesforce DX scratch directories
.sfdx/
.sf/
